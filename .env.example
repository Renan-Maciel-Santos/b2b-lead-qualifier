# Configuracoes do Banco de Dados
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=optime
# Usuario de aplicacao (restrito pelo RLS, sem BYPASSRLS)
DB_USER=optime_app
DB_PASSWORD=troque-esta-senha-do-app
# Superuser: usado SOMENTE por infraestrutura, migracoes (dbmate), seeds e fixtures de teste
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=troque-esta-senha-do-admin

# Configuracoes da API
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
OPENAI_API_KEY=sk-...

# Dominio da VPS para emissao automatica de HTTPS com Let's Encrypt (ex: api.seudominio.com.br)
# Deixe em branco se for acessar diretamente pelo IP ou Nginx proprio da VPS
DOMAIN=api.seudominio.com.br
