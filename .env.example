# Database Configuration (PostgreSQL 17 + pgvector)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=b2b_lead_qualifier
# Application unprivileged user (enforced by RLS, no BYPASSRLS)
DB_USER=app_user
DB_PASSWORD=change-this-app-password
# Superuser: used only by infrastructure, migrations (dbmate), seeds, and test setup
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change-this-admin-password
# Dedicated admin connection for CLI API key provisioning (never used by the web app)
ADMIN_DATABASE_URL=postgresql://postgres:change-this-admin-password@127.0.0.1:5432/b2b_lead_qualifier

# Application Settings
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
OPENAI_API_KEY=sk-...

# Production Domain for automatic TLS certificate with Caddy (optional)
DOMAIN=
